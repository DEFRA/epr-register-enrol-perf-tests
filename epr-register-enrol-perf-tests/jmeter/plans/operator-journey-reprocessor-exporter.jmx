        <!-- 21a reset crumb_token so the while-condition below can't reuse
             a stale valid-looking value left over from the upload step and
             skip polling on its very first check -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler"
                       testname="21a Reset crumb_token before poll">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">vars.put('crumb_token', 'CRUMB_NOT_FOUND')</stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- 21 GET sampling-plan/status (poll every 2s, like the page's own meta-refresh, until scan completes) -->
        <WhileController guiclass="WhileControllerGui" testclass="WhileController"
                          testname="21 Poll sampling-plan/status until scan completes">
          <stringProp name="WhileController.condition">${__javaScript("${crumb_token}"=="CRUMB_NOT_FOUND" &amp;&amp; ${__counter(TRUE,)}&lt;=12,)}</stringProp>
        </WhileController>
