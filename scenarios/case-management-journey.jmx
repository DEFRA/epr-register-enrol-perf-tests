        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Claim next work item: approve queue" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script"><![CDATA[
def queue = props.get("cmsApproveQueue")
def id = queue == null ? null : queue.poll()
if (id == null) {
    throw new org.apache.jorphan.util.JMeterStopThreadException("cmsApproveQueue empty — no more 'Not started' work items to approve")
}
vars.put("workItemId", id)
]]></stringProp>
