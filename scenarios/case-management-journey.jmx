        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script"><![CDATA[
def queue = props.get("cmsRefuseQueue")
def id = queue == null ? null : queue.poll()
if (id == null) {
    throw new org.apache.jorphan.util.JMeterStopThreadException("cmsRefuseQueue empty — no more 'Not started' work items to refuse")
}
vars.put("workItemId", id)
]]></stringProp>
