          </elementProp>
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DATA_DIR" elementType="Argument">
            <stringProp name="Argument.name">DATA_DIR</stringProp>
            <stringProp name="Argument.value">${__P(data_dir,jmeter/data)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement"
                         testname="HTTP Request Defaults" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${BASE_URL}</stringProp>
        <stringProp name="HTTPSampler.port">${PORT}</stringProp>
        <stringProp name="HTTPSampler.protocol">${PROTOCOL}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
        <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
        <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
      </ConfigTestElement>
      <hashTree/>

      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup"
                        testname="Setup: Discover 'Not started' work items" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController"
                     guiclass="LoopControlPanel" testclass="LoopController"
                     testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">1</intProp>
        </elementProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Discover and queue 'Not started' work items" enabled="true">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script"><![CDATA[
import java.util.regex.Pattern
import java.util.concurrent.ConcurrentLinkedQueue

def base = vars.get("PROTOCOL") + "://" + vars.get("BASE_URL") + ":" + vars.get("PORT")
def cookies = [:]

def doRequest = { String path, String method, String body ->
    def conn = (HttpURLConnection) new URL(base + path).openConnection()
    conn.setRequestMethod(method)
    conn.setInstanceFollowRedirects(false)
    conn.setConnectTimeout(10000)
    conn.setReadTimeout(15000)
    if (!cookies.isEmpty()) {
        conn.setRequestProperty("Cookie", cookies.collect { k, v -> k + "=" + v }.join("; "))
    }
    if (body != null) {
        conn.setDoOutput(true)
        conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded")
        conn.getOutputStream().write(body.getBytes("UTF-8"))
    }
    def status = conn.getResponseCode()
    def stream = status >= 400 ? conn.getErrorStream() : conn.getInputStream()
    def respBody = stream == null ? "" : stream.getText("UTF-8")
    def setCookieHeaders = conn.getHeaderFields().find { k, v -> k != null && k.equalsIgnoreCase("Set-Cookie") }?.value
    if (setCookieHeaders != null) {
        setCookieHeaders.each { sc ->
            def parts = sc.split(";")[0].split("=", 2)
            if (parts.length == 2) { cookies[parts[0]] = parts[1] }
        }
    }
    return [status: status, body: respBody]
}

// Stub login (RA-... stub auth) — nation left blank so this session can see
// and act on 'Not started' work items regardless of which nation they
// belong to, rather than tracking a per-item nation like the old CSV did.
def loginPage = doRequest("/auth/stub/login", "GET", null)
def crumbMatcher = (loginPage.body =~ /name="crumb"\s+value="([^"]+)"/)
if (!crumbMatcher.find()) {
    throw new RuntimeException("crumb not found on stub login page (status=" + loginPage.status + ")")
}
def crumb = crumbMatcher.group(1)

def loginResp = doRequest("/auth/stub/login", "POST", "crumb=" + URLEncoder.encode(crumb, "UTF-8") + "&nation=")
if (loginResp.status != 302) {
    throw new RuntimeException("stub login POST failed, status=" + loginResp.status)
}

// Page through the work-items list filtered to status=submitted ("Not
// started" in the UI) with the "Your applications" assignee filter removed
// (assigneeMode=any), collecting every work item id via its state-tag
// data-testid, until a page comes back with no matches.
def idPattern = Pattern.compile('data-testid="work-item-state-tag-([0-9a-fA-F-]+)"')
def allIds = new LinkedHashSet<String>()
def page = 1
while (page <= 50) {
    def listResp = doRequest("/work-items?status=submitted&assigneeMode=any&filtersApplied=1&page=" + page, "GET", null)
    def matcher = idPattern.matcher(listResp.body)
    def foundOnPage = 0
    while (matcher.find()) {
        allIds.add(matcher.group(1))
        foundOnPage++
    }
    if (foundOnPage == 0) {
        break
    }
    page++
}

// Split discovered ids ~40/30/30 across approve/refuse/query, matching the
// old CSV seed's own default ratio (43/29/28), and hand each thread group
// its own thread-safe queue via the cross-thread-group `props` store.
def idsList = new ArrayList<String>(allIds)
Collections.shuffle(idsList)
def total = idsList.size()
def approveCount = (int) Math.round(total * 0.4)
def refuseCount = (int) Math.round(total * 0.3)

def approveQueue = new ConcurrentLinkedQueue<String>()
def refuseQueue = new ConcurrentLinkedQueue<String>()
def queryQueue = new ConcurrentLinkedQueue<String>()

idsList.eachWithIndex { id, idx ->
    if (idx < approveCount) {
        approveQueue.add(id)
    } else if (idx < approveCount + refuseCount) {
        refuseQueue.add(id)
    } else {
        queryQueue.add(id)
    }
}

props.put("cmsApproveQueue", approveQueue)
props.put("cmsRefuseQueue", refuseQueue)
props.put("cmsQueryQueue", queryQueue)

def summary = "Discovered " + total + " 'Not started' work items -> approve=" + approveQueue.size() + " refuse=" + refuseQueue.size() + " query=" + queryQueue.size()
log.info(summary)
SampleResult.setResponseData(summary, "UTF-8")
SampleResult.setResponseCodeOK()
SampleResult.setSuccessful(total > 0)
SampleResult.setResponseMessage(summary)
]]></stringProp>
      </JSR223Sampler>
