            </ResponseAssertion>
            <hashTree/>
            <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                            testname="Extract crumb_token">
              <stringProp name="RegexExtractor.useHeaders">false</stringProp>
              <stringProp name="RegexExtractor.refname">crumb_token</stringProp>
              <stringProp name="RegexExtractor.regex">name="crumb"\s+value="([^"]+)"</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default">CRUMB_NOT_FOUND</stringProp>
              <stringProp name="RegexExtractor.match_no">1</stringProp>
            </RegexExtractor>
            <hashTree/>
          </hashTree>

          <!-- 22e POST confirm-overseas-sites (confirm) -->
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="22e POST confirm-overseas-sites (confirm)">
            <stringProp name="HTTPSampler.path">/accreditation/confirm-overseas-sites/${applicationId}</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="crumb" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.name">crumb</stringProp>
                  <stringProp name="Argument.value">${crumb_token}</stringProp>
                </elementProp>
                <elementProp name="submitAction" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.name">submitAction</stringProp>
                  <stringProp name="Argument.value">confirm</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree/>

          <!-- 22f GET upload-evidence-for-overseas-site; also extracts every
               site's siteId (match_no=-1 -> siteId_1..siteId_n, siteId_matchNr)
               so the ForEach loop below can visit each one. Some PerfTest
               Exporter fixtures have EU/OECD sites needing no evidence
               (operator-journey-reprocessor-exporter.jmx's original "already-
               accredited, straight continue" assumption), but others have
               non-EU/non-OECD sites that genuinely require an uploaded
               evidence file before "continue" succeeds (verified: POST
               without one returns 400 "incompleteEvidence"). Uploading
               evidence for every site unconditionally; rather than parsing
               each site's "required"/"not required" status; is simpler and
               harmless for sites that didn't strictly need it. -->
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="22f GET upload-evidence-for-overseas-site">
            <stringProp name="HTTPSampler.path">/accreditation/upload-evidence-for-overseas-site/${applicationId}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                               testname="Assert 200">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="200">200</stringProp>
              </collectionProp>
              <intProp name="Assertion.test_type">2</intProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            </ResponseAssertion>
            <hashTree/>
            <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                            testname="Extract crumb_token">
              <stringProp name="RegexExtractor.useHeaders">false</stringProp>
              <stringProp name="RegexExtractor.refname">crumb_token</stringProp>
              <stringProp name="RegexExtractor.regex">name="crumb"\s+value="([^"]+)"</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default">CRUMB_NOT_FOUND</stringProp>
              <stringProp name="RegexExtractor.match_no">1</stringProp>
            </RegexExtractor>
            <hashTree/>
            <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                            testname="Extract siteId (all sites)">
              <stringProp name="RegexExtractor.useHeaders">false</stringProp>
              <stringProp name="RegexExtractor.refname">siteId</stringProp>
              <stringProp name="RegexExtractor.regex">upload-bes-evidence/[^/]+/(\d+)"</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default"></stringProp>
              <stringProp name="RegexExtractor.match_no">-1</stringProp>
            </RegexExtractor>
            <hashTree/>
          </hashTree>

          <!-- ForEach site: upload evidence -> wait for CDP scan -> "no more
               evidence" -> confirm CYA -> back to the evidence list. Reuses
               the same multipart/CDP-scan-wait pattern already proven for
               sampling-plan (steps 19-22 above). -->
          <ForeachController guiclass="ForeachControlPanel" testclass="ForeachController"
                              testname="ForEach overseas site: upload evidence">
            <stringProp name="ForeachController.inputVal">siteId</stringProp>
            <stringProp name="ForeachController.returnVal">currentSiteId</stringProp>
            <boolProp name="ForeachController.useSeparator">true</boolProp>
          </ForeachController>
          <hashTree>

            <!-- 22f1 GET upload-bes-evidence -->
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                              testname="22f1 GET upload-bes-evidence">
              <stringProp name="HTTPSampler.path">/accreditation/upload-bes-evidence/${applicationId}/${currentSiteId}</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                                 testname="Assert 200">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="200">200</stringProp>
                </collectionProp>
                <intProp name="Assertion.test_type">2</intProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              </ResponseAssertion>
              <hashTree/>
              <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                              testname="Extract crumb_token">
                <stringProp name="RegexExtractor.useHeaders">false</stringProp>
                <stringProp name="RegexExtractor.refname">crumb_token</stringProp>
                <stringProp name="RegexExtractor.regex">name="crumb"\s+value="([^"]+)"</stringProp>
                <stringProp name="RegexExtractor.template">$1$</stringProp>
                <stringProp name="RegexExtractor.default">CRUMB_NOT_FOUND</stringProp>
                <stringProp name="RegexExtractor.match_no">1</stringProp>
              </RegexExtractor>
              <hashTree/>
            </hashTree>

            <!-- 22f2 POST upload-bes-evidence; upload file (multipart/form-data) -->
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                              testname="22f2 POST upload-bes-evidence (upload file)">
              <stringProp name="HTTPSampler.path">/accreditation/upload-bes-evidence/${applicationId}/${currentSiteId}</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <boolProp name="HTTPSampler.DO_MULTIPART_POST">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="crumb" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">true</boolProp>
                    <stringProp name="Argument.name">crumb</stringProp>
                    <stringProp name="Argument.value">${crumb_token}</stringProp>
                  </elementProp>
                  <elementProp name="action" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.name">action</stringProp>
                    <stringProp name="Argument.value">uploadFile</stringProp>
                  </elementProp>
                  <elementProp name="validFromDay" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.name">validFromDay</stringProp>
                    <stringProp name="Argument.value">1</stringProp>
                  </elementProp>
                  <elementProp name="validFromMonth" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.name">validFromMonth</stringProp>
                    <stringProp name="Argument.value">1</stringProp>
                  </elementProp>
                  <elementProp name="validFromYear" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.name">validFromYear</stringProp>
                    <stringProp name="Argument.value">2024</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
              <elementProp name="HTTPsampler.Files" elementType="HTTPFileArgs">
                <collectionProp name="HTTPFileArgs.files">
                  <elementProp name="sampling-plan.pdf" elementType="HTTPFileArg">
                    <stringProp name="File.path">${__P(test_files_dir,jmeter/test-files)}/sampling-plan.pdf</stringProp>
                    <stringProp name="File.paramname">file</stringProp>
                    <stringProp name="File.mimetype">application/pdf</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree/>

            <!-- 22f2a reset crumb_token so the while-condition below can't
                 reuse a stale valid-looking value left over from the upload
                 step and skip polling on its very first check -->
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler"
                           testname="22f2a Reset crumb_token before poll">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">vars.put('crumb_token', 'CRUMB_NOT_FOUND')</stringProp>
            </JSR223Sampler>
            <hashTree/>

            <!-- 22f3 GET upload-bes-evidence/status; polls every 2s until the
                 scan completes, same reasoning and pattern as step 21's
                 sampling-plan poll above: a single fixed wait is not reliably
                 enough once CDP-uploader is under real concurrent load
                 (confirmed here too: the "still scanning" page has no crumb
                 field, matching status.njk). -->
            <WhileController guiclass="WhileControllerGui" testclass="WhileController"
                              testname="22f3 Poll upload-bes-evidence/status until scan completes">
              <stringProp name="WhileController.condition">${__javaScript("${crumb_token}"=="CRUMB_NOT_FOUND" &amp;&amp; ${__counter(TRUE,)}&lt;=12,)}</stringProp>
            </WhileController>
            <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                              testname="22f3 GET upload-bes-evidence status (wait for scan)">
              <stringProp name="HTTPSampler.path">/accreditation/upload-bes-evidence/${applicationId}/${currentSiteId}/status</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer"
                             testname="Wait 2s between polls (matches the page's meta-refresh)">
                <stringProp name="ConstantTimer.delay">2000</stringProp>
              </ConstantTimer>
              <hashTree/>
              <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                              testname="Extract crumb_token">
                <stringProp name="RegexExtractor.useHeaders">false</stringProp>
                <stringProp name="RegexExtractor.refname">crumb_token</stringProp>
                <stringProp name="RegexExtractor.regex">name="crumb"\s+value="([^"]+)"</stringProp>
                <stringProp name="RegexExtractor.template">$1$</stringProp>
                <stringProp name="RegexExtractor.default">CRUMB_NOT_FOUND</stringProp>
                <stringProp name="RegexExtractor.match_no">1</stringProp>
              </RegexExtractor>
              <hashTree/>
            </hashTree>
            </hashTree>

            <!-- 22f4 POST upload-more-evidence; "no", one file is enough -->
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                              testname="22f4 POST upload-more-evidence (no)">
              <stringProp name="HTTPSampler.path">/accreditation/upload-more-evidence/${applicationId}/${currentSiteId}</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="crumb" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">true</boolProp>
                    <stringProp name="Argument.name">crumb</stringProp>
                    <stringProp name="Argument.value">${crumb_token}</stringProp>
                  </elementProp>
                  <elementProp name="answer" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.name">answer</stringProp>
                    <stringProp name="Argument.value">no</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                              testname="Extract crumb_token">
                <stringProp name="RegexExtractor.useHeaders">false</stringProp>
                <stringProp name="RegexExtractor.refname">crumb_token</stringProp>
                <stringProp name="RegexExtractor.regex">name="crumb"\s+value="([^"]+)"</stringProp>
                <stringProp name="RegexExtractor.template">$1$</stringProp>
                <stringProp name="RegexExtractor.default">CRUMB_NOT_FOUND</stringProp>
                <stringProp name="RegexExtractor.match_no">1</stringProp>
              </RegexExtractor>
              <hashTree/>
            </hashTree>

            <!-- 22f5 POST cya-evidence-for-overseas-site; confirm, redirects
                 back to the evidence list (GET first, matching the app's own
                 crumb-per-response convention, though the POST controller
                 itself does not validate any payload beyond the crumb) -->
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                              testname="22f5 GET cya-evidence-for-overseas-site">
              <stringProp name="HTTPSampler.path">/accreditation/cya-evidence-for-overseas-site/${applicationId}/${currentSiteId}</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                                 testname="Assert 200">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="200">200</stringProp>
                </collectionProp>
                <intProp name="Assertion.test_type">2</intProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              </ResponseAssertion>
              <hashTree/>
              <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                              testname="Extract crumb_token">
                <stringProp name="RegexExtractor.useHeaders">false</stringProp>
                <stringProp name="RegexExtractor.refname">crumb_token</stringProp>
                <stringProp name="RegexExtractor.regex">name="crumb"\s+value="([^"]+)"</stringProp>
                <stringProp name="RegexExtractor.template">$1$</stringProp>
                <stringProp name="RegexExtractor.default">CRUMB_NOT_FOUND</stringProp>
                <stringProp name="RegexExtractor.match_no">1</stringProp>
              </RegexExtractor>
              <hashTree/>
            </hashTree>

            <!-- 22f6 POST cya-evidence-for-overseas-site (confirm) -->
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                              testname="22f6 POST cya-evidence-for-overseas-site (confirm)">
              <stringProp name="HTTPSampler.path">/accreditation/cya-evidence-for-overseas-site/${applicationId}/${currentSiteId}</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="crumb" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">true</boolProp>
                    <stringProp name="Argument.name">crumb</stringProp>
                    <stringProp name="Argument.value">${crumb_token}</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree/>

          </hashTree>

          <!-- 22g GET upload-evidence-for-overseas-site; re-fetch for a fresh
               crumb after the ForEach loop above (many requests have happened
               since 22f's crumb was extracted; hapi-crumb rotates every
               response) -->
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="22g GET upload-evidence-for-overseas-site (refresh crumb)">
            <stringProp name="HTTPSampler.path">/accreditation/upload-evidence-for-overseas-site/${applicationId}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
