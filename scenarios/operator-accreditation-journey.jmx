        <!-- 26 GET submit-confirmation -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="26 GET submit-confirmation">
          <stringProp name="HTTPSampler.path">/accreditation/submit-confirmation/${applicationId}</stringProp>
