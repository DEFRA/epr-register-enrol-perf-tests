             Step 3 – mark section complete (action=saveAndContinue)
             Note: ScanStatus=Pending is treated as eligible.
             ───────────────────────────────────────────────────── -->

        <!-- 19 GET sampling-plan -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="19 GET sampling-plan">
          <stringProp name="HTTPSampler.path">/accreditation/sampling-plan/${applicationId}</stringProp>
