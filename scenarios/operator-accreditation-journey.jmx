                <stringProp name="File.paramname">file</stringProp>
                <stringProp name="File.mimetype">application/pdf</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>

        <!-- 21a reset crumb_token so the while-condition below can't reuse a
             stale valid-looking value left over from the upload step and skip
             polling on its very first check -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler"
                       testname="21a Reset crumb_token before poll">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">vars.put('crumb_token', 'CRUMB_NOT_FOUND')</stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- 21 GET sampling-plan/status; polls every 2s (matching the page's
             own meta-refresh) until scan completes, instead of a single fixed
             wait: verified against operator-journey-reprocessor-exporter.jmx,
             which uses this exact pattern at 100-user scale because a fixed
             5s wait proved insufficient once CDP-uploader is under real
             concurrent load (the "still scanning" page has no crumb field, so
             the extractor's CRUMB_NOT_FOUND default is what the loop
             condition polls on). -->
        <WhileController guiclass="WhileControllerGui" testclass="WhileController"
                          testname="21 Poll sampling-plan/status until scan completes">
          <stringProp name="WhileController.condition">${__javaScript("${crumb_token}"=="CRUMB_NOT_FOUND" &amp;&amp; ${__counter(TRUE,)}&lt;=12,)}</stringProp>
        </WhileController>
        <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="21 GET sampling-plan/status (wait for scan)">
          <stringProp name="HTTPSampler.path">/accreditation/sampling-plan/${applicationId}/status</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer"
                         testname="Wait 2s between polls (matches the page's meta-refresh)">
            <stringProp name="ConstantTimer.delay">2000</stringProp>
          </ConstantTimer>
          <hashTree/>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                          testname="Extract crumb_token">
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <stringProp name="RegexExtractor.refname">crumb_token</stringProp>
            <stringProp name="RegexExtractor.regex">name="crumb"\s+value="([^"]+)"</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">CRUMB_NOT_FOUND</stringProp>
            <stringProp name="RegexExtractor.match_no">1</stringProp>
          </RegexExtractor>
          <hashTree/>
        </hashTree>
        </hashTree>

        <!-- 22 POST sampling-plan results – mark section complete (file already
             uploaded; the CDP-scan redirect in step 21 lands on /results, and
             saveAndContinue is now only handled by the results route's POST) -->
